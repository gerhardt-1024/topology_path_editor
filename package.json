{
  "name": "topology-path-editor",
  "version": "1.0.3",
  "description": "A single-page React + Three.js application for visualizing point-cloud maps and editing topology nodes, edges, path points, and path-facing rotations.",
  "author": {
    "name": "Topology Path Editor",
    "email": "dev@example.com"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "verify:render": "node scripts/verify-render.js",
    "electron": "electron .",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "dist:exe": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^5.22.7",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0",
    "vite": "^6.0.3"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.59.1"
  },
  "build": {
    "appId": "com.topologypatheditor.app",
    "productName": "Topology Path Editor",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "gerhardt-1024",
      "repo": "topology_path_editor",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
